// Story texts
HE1TEXT = "The last golden head of the gate keepers\n"
          "fell at your hands. You decided to pray\n"
          "and then leave this cursed city, now more\n"
          "like a cemetery. The roar of the ghouls\n"
          "gradually fades - there is nothing ahead\n"
          "but scorched earth.\n"
          "\n"
          "The Order has done a good job exterminating\n"
          "everything in its path, but you know it's\n"
          "just another obstacle, part of a bigger\n"
          "trial. And even though the painful moans\n"
          "are far behind you, you are not alone.\n"
          "\n"
          "Faith is still with you, along with\n"
          "hordes of hungry monsters just waiting for\n"
          "the right moment.";
HE2TEXT = "The green colossi are defeated. You've\n"
          "met them before - the ogres are Gyte's\n"
          "personal guards and they're pretty tough.\n"
          "You can start to feel proud of yourself,\n"
          "but there's no time for that.\n"
          "\n"
          "You're filled with hatred and anger:\n"
          "it's time to send the main bastard back to\n"
          "the dead. Road to the domain of evil\n"
          "is open. Leap into the crevice,\n"
          "your skin burns, reality distorts...\n"
          "\n"
          "The Gods alone know how this ends, but\n"
          "they've all long since left us. And the\n"
          "only one equal to them in power is the\n"
          "one you're about to face.\n"
          "\n"
          "One of you is in for a gruesome demise.";
HE3TEXT = "The scream of an agonizing nemesis pierced\n"
          "the living to the bone. His body crumbled\n"
          "to ashes, the monsters around you began\n"
          "to decompose from the surge of power.\n"
          "Your vengeance is complete, the Order is gone.\n"
          "\n"
          "But that means the forces of evil are no\n"
          "longer in control. Endless hordes of\n"
          "monsters will march in legions to all\n"
          "worlds, devouring everything in their path.\n"
          "\n"
          "By opening Gyte's tomb, you used ancient magic\n"
          "to create a rift that brought you back to your\n"
          "homeworld. And then monsters did the exodus\n"
          "with you...";
HE4TEXT = "Episode 4 story text";
HE5TEXT = "Episode 5 story text";

RAVENQUITMSG = "You're leaving already?";

